# systemd unit для mining-proxy.
# Копируется в /etc/systemd/system/mining-proxy.service.
#
# Управление:
#   systemctl start mining-proxy    — запустить
#   systemctl enable mining-proxy   — автозапуск при загрузке
#   systemctl status mining-proxy   — статус
#   journalctl -u mining-proxy -f   — логи

[Unit]
Description=Mining Proxy — прозрачный Stratum-прокси со статистикой шар
# Запускаемся только после поднятия сети.
After=network.target
Wants=network-online.target

[Service]
# Процесс запускается напрямую (не fork-демон).
Type=simple
# Команда запуска: бинарник + путь к конфигу.
ExecStart=/usr/local/bin/mining-proxy --config /etc/mining-proxy/config.yaml
# Страховка при остановке/убийстве: даже если процесс убили (kill -9) и
# Cleanup в Go не выполнился — правила DNAT сняются, майнеры уходят в пул
# напрямую (fail-open). Идемпотентно: при чистом останове уже снято.
ExecStopPost=-/sbin/iptables -t nat -F MINING_PROXY
ExecStopPost=-/sbin/iptables -t nat -D PREROUTING -j MINING_PROXY
# Если процесс упадёт — systemd перезапустит его всегда.
Restart=always
# Пауза между перезапусками (чтобы не было цикла рестартов).
RestartSec=5
# Лимит открытых файловых дескрипторов: 65536.
# Нужен для обслуживания тысяч одновременных TCP-соединений от ASIC.
LimitNOFILE=65536

# --- Безопасность (systemd hardening) ---
# Прокси настраивает iptables и пишет sysctl — права root ему нужны.
NoNewPrivileges=no
# ProtectSystem=full делает /etc доступным только на чтение. Исключение —
# /etc/sysctl.d: туда пишутся постоянные настройки ядра (ip_forward,
# route_localnet) на случай, если setup.sh их не создал.
ReadWritePaths=/etc/sysctl.d
# Защита системных директорий от записи (/usr, /boot, /etc).
ProtectSystem=full

# --- Логи ---
# Логи пишем в journald (перехваты: journalctl -u mining-proxy -f).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mining-proxy

[Install]
# Сервис запускается в многопользовательском режиме (обычная загрузка).
WantedBy=multi-user.target
